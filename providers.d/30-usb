#!/bin/bash
# SPDX-License-Identifier: MIT
#
# diagnostics-logs provider: usb
#
# lsusb on the Dwarf is the busybox one (no names, no drivers): read sysfs

if [ "$1" = "--describe" ]; then
    echo "id=usb"
    echo "title=USB"
    echo "description=Connected USB devices, with the driver of each interface"
    exit 0
fi

attr()
{
    cat "$1/$2" 2>/dev/null
}

found=0
for dev in /sys/bus/usb/devices/*; do
    # devices only (e.g. 1-1, 2-1.3), not interfaces (1-1:1.0) nor root hubs (usb1)
    name=$(basename "$dev")
    case "$name" in
        *:*|usb*) continue ;;
    esac
    [ -f "$dev/idVendor" ] || continue
    found=1

    printf '%-8s %s:%s  %s %s  (USB %s, %s Mbit/s)\n' "$name" \
        "$(attr $dev idVendor)" "$(attr $dev idProduct)" \
        "$(attr $dev manufacturer)" "$(attr $dev product)" \
        "$(attr $dev version | tr -d ' ')" "$(attr $dev speed)"

    for intf in "$dev"/"$name":*; do
        [ -d "$intf" ] || continue
        driver=none
        [ -L "$intf/driver" ] && driver=$(basename "$(readlink "$intf/driver")")
        printf '         %s class %s: %s\n' "$(basename "$intf")" "$(attr $intf bInterfaceClass)" "$driver"
    done
done

[ $found = 1 ] || echo "no USB devices"
